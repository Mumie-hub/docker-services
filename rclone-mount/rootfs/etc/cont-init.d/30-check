#!/usr/bin/with-contenv sh

. /etc/colors.sh
. /etc/mount-functions.sh

PREFIX="[cont-init.d] $(s6-basename "${0}"):"

if [ ! -f "${ConfigPath}" ]; then
    echo -e "${PREFIX} ${Red}rclone config not found at ${ConfigPath}[ERROR]${Color_Off}"
    exit 1
fi

# a previous container that did not shut down cleanly leaves a dead mount behind
if isRcloneMounted; then
    echo -e "${PREFIX} ${Yellow}found stale mount at ${MountPoint}, unmounting${Color_Off}"
    fusermount ${UnmountCommands} "${MountPoint}" || umount -l "${MountPoint}"

    if isRcloneMounted; then
        echo -e "${PREFIX} ${Red}could not remove stale mount at ${MountPoint}[ERROR]${Color_Off}"
        exit 1
    fi
fi

if [ -n "$(ls -A "${MountPoint}" 2>/dev/null)" ]; then
    echo -e "${PREFIX} ${Yellow}MountPoint ${MountPoint} is not empty${Color_Off}"
fi

echo -e "${PREFIX} ${Green}MountPoint ${MountPoint} is ready${Color_Off}"
exit 0

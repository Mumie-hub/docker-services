#!/usr/bin/with-contenv sh

. /etc/colors.sh

PREFIX="[cont-init.d] $(s6-basename "${0}"):"

# strip trailing slashes, otherwise MountPoint never matches the entries in /proc/mounts
while [ "${MountPoint}" != "${MountPoint%/}" ]; do
    MountPoint="${MountPoint%/}"
done

if [ -z "${MountPoint}" ]; then
    echo -e "${PREFIX} ${Red}MountPoint must not be empty or /[ERROR]${Color_Off}"
    exit 1
fi

printf '%s' "${MountPoint}" > /var/run/s6/container_environment/MountPoint
printf '%s' "${ConfigDir}/${ConfigName}" > /var/run/s6/container_environment/ConfigPath

mkdir -p \
    "${MountPoint}" \
    "${ConfigDir}"

if [ "${AutoUpgrade}" = "true" ]; then
    echo -e "${PREFIX} ${Blue}installing system updates${Color_Off}"
    if ! apk --no-cache upgrade; then
        echo -e "${PREFIX} ${Yellow}system update failed, continuing with installed packages${Color_Off}"
    fi
fi

exit 0

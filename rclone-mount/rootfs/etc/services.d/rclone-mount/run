#!/usr/bin/with-contenv sh

. /etc/colors.sh

PREFIX="[services.d] [rclone-mount]-$(s6-basename "${0}"):"

echo -e "${PREFIX} ${Green}starting rclone mount $(date +%Y.%m.%d-%T)${Color_Off}"

if [ "${DEBUG}" = "true" ]; then
    echo -e "${PREFIX} [DEBUG] command: /usr/local/sbin/rclone --config ${ConfigPath} mount ${RemotePath} ${MountPoint} ${MountCommands}"
fi

# exec so s6 supervises and signals rclone directly; MountCommands is left unquoted to split into flags
exec /usr/local/sbin/rclone --config "${ConfigPath}" mount "${RemotePath}" "${MountPoint}" ${MountCommands}

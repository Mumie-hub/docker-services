#!/usr/bin/with-contenv sh

. /etc/colors.sh

PREFIX="[services.d] [rclone-mount]-$(s6-basename "${0}"):"

# s6 passes the exit code as $1 (256 if rclone was killed by a signal) and the signal number as $2
ExitCode="${1}"
Signal="${2}"

stopped(){
    echo -e "${PREFIX} ${Yellow}rclone stopped (exit code ${ExitCode}${Signal:+, signal ${Signal}})${Color_Off}"
    exit 0
}

crashed(){
    # mark the service down so s6 does not restart rclone on the dead mount before the container stops
    s6-svc -d /var/run/s6/services/rclone-mount
    # bring the container down so cont-finish.d cleans up the mount and the restart policy takes over
    echo -e "${PREFIX} ${Red}rclone exited unexpectedly (exit code ${ExitCode}${Signal:+, signal ${Signal}}), stopping container[ERROR]${Color_Off}"
    s6-svscanctl -t /var/run/s6/services
    exit 0
}

case "${ExitCode}" in
    0|130|143)
        stopped
        ;;
    256)
        case "${Signal}" in
            2|15) stopped ;;
            *) crashed ;;
        esac
        ;;
    *)
        crashed
        ;;
esac

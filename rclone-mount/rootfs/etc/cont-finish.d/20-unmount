#!/usr/bin/with-contenv sh

. /etc/colors.sh
. /etc/mount-functions.sh

PREFIX="[cont-finish.d] $(s6-basename "${0}"):"

# s6 kills this script after S6_KILL_FINISH_MAXTIME, keep time left for the forced unmount
WaitTime=$(( ${S6_KILL_FINISH_MAXTIME:-5000} - 2000 ))
if [ "${WaitTime}" -lt 1000 ]; then
    WaitTime=1000
fi

echo -e "${PREFIX} ${Yellow}waiting up to ${WaitTime}ms for rclone to stop${Color_Off}"
s6-svwait -D -t "${WaitTime}" /var/run/s6/services/rclone-mount

if isRcloneMounted; then
    echo -e "${PREFIX} ${Red}force unmounting with fusermount ${UnmountCommands} at: $(date +%Y.%m.%d-%T)${Color_Off}"
    fusermount ${UnmountCommands} "${MountPoint}" || umount -l "${MountPoint}"
    exit 1
fi

echo -e "${PREFIX} ${Green}successfully unmounted${Color_Off}"
exit 0
